<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch theme, used for the window before Compose draws its first frame.
      Dark with a felt background so there is no white flash on cold start — the app is a
      dark green table on both platforms and has no light mode (PLAN.md §6).
    -->
    <style name="Theme.PairForTwo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/felt_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      The launch screen, via `core-splashscreen` so it behaves the same from API 26 to the system
      splash of Android 12+. Felt behind the app's own icon: iOS shows its launch art on the same
      dark green, and the point of both is that the first frame is already the table's colour.

      The icon is `@drawable/splash_icon`, not the launcher icon — the splash draws it at a size the
      launcher assets are nowhere near big enough for. See that file.
    -->
    <style name="Theme.PairForTwo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/felt_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.PairForTwo</item>
    </style>
</resources>
